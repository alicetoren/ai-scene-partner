OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# Ordered palette; the default voice above is always first. Names are deduplicated.
OPENAI_TTS_VOICES=marin,cedar,coral,ash
# App-curated categories; OpenAI does not define voice genders.
OPENAI_TTS_FEMININE_VOICES=coral,nova,shimmer
OPENAI_TTS_MASCULINE_VOICES=cedar,onyx,echo
